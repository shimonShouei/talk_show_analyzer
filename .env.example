# Database
DATABASE_URL=postgresql://user:password@localhost/talk_show_analyzer

# Audio processing
AUDIO_FORMAT=mp3
AUDIO_BITRATE=128k
AUDIO_SAMPLE_RATE=16000
AUDIO_CHANNELS=1

# Whisper transcription (free, self-hosted)
WHISPER_MODEL=base                    # Options: tiny, base, small, medium, large
WHISPER_DEVICE=auto                   # Options: cuda, cpu, auto
WHISPER_COMPUTE_TYPE=float16          # Options: float16, float32, int8

# Diarization (free, self-hosted)
PYANNOTE_DEVICE=auto                  # Options: cuda, cpu, auto
PYANNOTE_NUM_SPEAKERS=                # Leave empty for auto-detection

# HuggingFace token for Pyannote models
# Get from https://huggingface.co/settings/tokens
HF_TOKEN=hf_your_token_here

# Claude API (for analysis)
ANTHROPIC_API_KEY=sk_your_key_here

# Storage
OUTPUT_DIR=./data
S3_BUCKET=                             # Optional: for cloud backup
GCS_BUCKET=                            # Optional: for cloud backup

# Logging
LOG_LEVEL=INFO
